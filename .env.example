# Copy this file to .env and fill in your values.
# NEVER commit .env or share your private key.

# Helius (dashboard.helius.dev). Paste the API key only — RPC/WSS are filled in.
# Free plan is enough to test. Do not commit this key.
HELIUS_API_KEY=
# Optional overrides if you use a custom Helius URL instead of the key helper:
# RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# WSS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY
#
# Do NOT swap in a region-pinned Helius host (e.g. laserstream-mainnet-fra...).
# Helius auto-routes mainnet.helius-rpc.com through Cloudflare anycast, which from
# this machine measured ~14ms median. The explicit regional hosts measured 120ms
# (Frankfurt) to 256ms (Tokyo) because they are direct datacenter IPs, so pinning a
# region makes latency ~8x WORSE. Helius only offers region choice for LaserStream
# and Dedicated Nodes, and then only so you can colocate a server next to the node.

# Wallet secret: Phantom/Solflare base58 export
PRIVATE_KEY=your_base58_private_key_here

# Or a Solana CLI JSON array instead of PRIVATE_KEY:
# PRIVATE_KEY_JSON=[1,2,3,...]

# processed | confirmed | finalized
COMMITMENT=processed

# Pump.fun program (mainnet)
PUMP_FUN_PROGRAM_ID=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P

# --- Trading ---
# Dry-run simulates buys/sells. Live sends require BOTH:
#   DRY_RUN=false
#   ENABLE_LIVE_TRADING=true
DRY_RUN=true
ENABLE_LIVE_TRADING=false
BUY_ON_NEW_TOKEN=true
SCAN_EXISTING_COINS=false
SCAN_PAGE_SIZE=50
SCAN_INTERVAL_SECONDS=3
SCAN_REVIEW_DELAY_SECONDS=0.05

# Size limits (SOL) — each paper trade is a fixed 1 SOL
BUY_SOL_AMOUNT=1
BUY_PROBE_SOL=1.0
BUY_ADD_SOL=0
MAX_SOL_PER_TRADE=1
PAPER_ACCOUNT_SOL=100
MAX_ACCOUNT_RISK_PCT=10
MAX_OPEN_POSITIONS=16
CONFIRM_SECONDS=5
CONFIRM_EXPIRE_SECONDS=25
ADD_AFTER_SECONDS=10
MIN_UNIQUE_BUYERS=15
MIN_CONFIRM_BUY_SOL=2
MIN_CONFIRM_NET_SOL=1
MAX_CONFIRM_SELL_RATIO=0.5
MIN_CONFIRM_MC_USD=5000
SIM_SLIPPAGE_BPS=200
REGIME_FILTER_ENABLED=false
MIN_ADD_UNIQUE_BUYERS=0
MIN_ADD_MC_USD=5000
DEAD_COIN_SECONDS=30
DEAD_COIN_MIN_PNL_PCT=10
MAX_TRADES=100
MIN_SOL_RESERVE=0.02

# Exit filters (percent). Hard SL at -6%. Once price is +3.5%, the stop moves to entry.
# Trailing TP still arms at +30% then sells on a 15% drop from peak.
STOP_LOSS_PCT=6
BREAKEVEN_ARM_PCT=5
TAKE_PROFIT_PCT=30
TAKE_PROFIT_TRIGGER_PCT=12
TRAILING_STOP_PCT=10
TRAILING_LOCK_BREAKEVEN=true
SLIPPAGE_BPS=800

PRIORITY_FEE_MICROLAMPORTS=100000
COMPUTE_UNIT_LIMIT=250000
POSITION_POLL_SECONDS=2
TRAILING_TICK_SECONDS=0.25
TRAILING_ARMED_TICK_SECONDS=0.08
TRAILING_STALE_SECONDS=0.2

# --- Security filters (dry-run and live) ---
SECURITY_FILTERS_ENABLED=true
MIN_LIQUIDITY_USD=0
MAX_INSIDER_TOKENS=100000000
MAX_HOLDER_PCT=30
MAX_TAX_BPS=100
SOL_USD_FALLBACK=150
REJECT_FREEZE_AUTHORITY=true
REJECT_EXTERNAL_MINT_AUTH=true
REJECT_TRANSFER_FEE=true
REJECT_MUTABLE_TAX=true
REJECT_UNVERIFIED=false
REJECT_PERMANENT_DELEGATE=true
REJECT_TRANSFER_HOOK=true
REJECT_NON_TRANSFERABLE=true
REJECT_PAUSABLE=true
MIN_LP_LOCKED_PCT=0
MAX_CREATOR_HOLD_PCT=10
MIN_HOLDERS=0
BUNDLE_WALLET_COUNT=8
MAX_CREATOR_LAUNCHES=5
MAX_CREATOR_RUGS=1
REJECT_CLONE_TICKERS=true
REJECT_UNKNOWN_TOKEN_PROGRAM=true
HONEYPOT_SIMULATION=true

# --- Graduation (bonding curve -> PumpSwap AMM) handling ---
# When a coin completes its curve the curve account closes and reads back zero
# reserves. Hold through graduation and re-price from the AMM instead of
# liquidating the winner for -100%.
HOLD_THROUGH_GRADUATION=true
GRADUATION_PRICE_TIMEOUT_SECONDS=120


# --- Tiered trailing tolerance ---
# The trailing callback widens as the peak gain grows so a coin that multiplies
# is not cut off by a normal wobble. (peak gain %, callback %), ascending.
TRAIL_TIER_1_PEAK=50
TRAIL_TIER_1_CALLBACK=18
TRAIL_TIER_2_PEAK=150
TRAIL_TIER_2_CALLBACK=28
TRAIL_TIER_3_PEAK=500
TRAIL_TIER_3_CALLBACK=38
TRAIL_TIER_4_PEAK=2000
TRAIL_TIER_4_CALLBACK=48

# --- Ratchet floor (prevents a winner round-tripping into a loss) ---
# Once the peak gain passes a level, the position can never be sold below the
# paired gain. Floors are deliberately tighter than the trailing tolerance so
# they bind first. (peak gain %, locked minimum gain %).
RATCHET_1_PEAK=50
RATCHET_1_FLOOR=25
RATCHET_2_PEAK=150
RATCHET_2_FLOOR=100
RATCHET_3_PEAK=500
RATCHET_3_FLOOR=350
RATCHET_4_PEAK=2000
RATCHET_4_FLOOR=1400
# MAX_OPEN_POSITIONS=16 is bounded by the account-level budget above: 10% of the
# 100 SOL paper account means at most 10 SOL across all open positions.

# --- Gradual partial profit-taking (correlates with MC growth) ---
# A flat ladder of mc:pct pairs. At each level, sell pct% of the tokens still held
# and let the remainder keep riding. Default: 15% at each step from $150k to $8M,
# which banks proportionally at whatever level a coin actually reaches and leaves
# ~20% still exposed if it gets to $8M. Set to "off" for pure ride (no early sells).
MC_SCALE_OUT_LADDER=50000:50,100000:30,175000:30,300000:30,500000:40,750000:40,1000000:100
